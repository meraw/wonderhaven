 "naps": {
  "paper": "Il Gabbiano",
  "gags": {
   "newspaper": {
    "weight": 3,
    "lines": [
     "You wake up under yesterday's {paper}. A gull is reading the back page.",
     "Somebody tucked you in with the {paper}. The wind off the sea takes it back, page by page.",
     "You slept under the {paper}'s tide tables. The tide came in. The paper went out."
    ]
   },
   "umbrella": {
    "weight": 1,
    "lines": [
     "Somebody left Nunzia's spare umbrella open beside the bench. It kept the gulls off, mostly."
    ]
   },
   "train": {
    "weight": 2,
    "lines": [
     "The first train bursts out of the tunnel with its horn full on. You are awake. So is the whole coast.",
     "A horn from the tunnel, a rush of wind, a carriage full of commuters staring at you. Good morning, Serenza."
    ]
   },
   "sturlese": {
    "weight": 2,
    "lines": [
     "Ragionier Sturlese is asleep at the other end of the bench, his briefcase for a pillow. He missed the last train. Again.",
     "You share the bench with Sturlese, who snores in triplicate. His briefcase is stamped RECEIVED."
    ]
   },
   "stared": {
    "weight": 3,
    "visual": true
   },
   "rain": {
    "visual": true
   }
  }
 },
 "paper": {
  "done": [
   "{title}: done, and Marta has faxed a press release to forty numbers",
   "{title} finished. Il Gabbiano's reporter came down on the 8:10 to see",
   "Geometra completes {title}; Presidente Crovara says it'll do. For now"
  ],
  "built": [
   "{n} new pieces on the cliff overnight; the gulls have inspected every one",
   "Geometra puts up {n} pieces in Serenza. Ragionier Sturlese has measured them all",
   "{n} new pieces in Serenza, and not one of them taller than the bell tower"
  ],
  "opened": [
   "Marta Bonanni launches {what} {place}, with slogans",
   "Ribbon cut on {what} {place}. Settimio grumbled from the back, approvingly",
   "{What} {place}: a disposable camera flashes, a press release is faxed to nobody"
  ],
  "quiet": [
   "Quiet day in Serenza. The 14:30 was on time, which made the news",
   "Nothing built yesterday. Capo Horn told a story instead, about Cape Horn",
   "Slow news day: a gull stole a focaccia outside Nunzia's bar"
  ],
  "approval": "",
  "verdict": "Il Gabbiano's verdict on the new build in Serenza: {grade}.",
  "regrown": "Overnight the brambles crept back, the lemons ripened and the wall-stone heaps settled again."
 },
 "inauguration": {
  "speaker": "cliffs_marta",
  "place": "in Serenza",
  "open": [
   "Serenza! Tonight we launch {what} {place}. Smile for the camera!",
   "Gather round, everyone: {what} {place}. I've written a slogan.",
   "Ladies and gentlemen, and Nonno: {What} {place}. Press release to follow."
  ],
  "body": {
   "need": [
    "You kept saying: \u201c{noticed}\u201d Well, now you've got it."
   ],
   "own": [
    "Right where you wanted it. You're welcome."
   ],
   "art": [
    "What's it for? It's for the photographs.",
    "It does nothing at all, beautifully. Very nineties."
   ],
   "tall": [
    "Not taller than the bell tower. Ragionier Sturlese checked."
   ],
   "colour": [
    "A colour! On a cliff full of colours. It fits right in."
   ],
   "many": [
    "{n} pieces in a day. In Toriano that's a whole agency's week."
   ],
   "single": [
    "One {piece}. Small, but on the coast that's a landmark."
   ],
   "plain": [
    "It stands. On this cliff, that's a selling point.",
    "Solid work. Nonno tapped it with his stick and said nothing, which is a compliment."
   ]
  },
  "close": [
   "The Geometra built it, I wrote the slogan. Scissors!",
   "Click! That's the cover of the brochure. Cut the ribbon!",
   "Nonno, put your hat back on. Cut the ribbon!"
  ]
 },
 "lost": [
  "Ragionier Sturlese's season ticket",
  "Marta's Walkman, the tape still in it",
  "Nunzia's umbrella, inside out",
  "a cassette: Hits of the Summer of '97",
  "Capo Horn's photograph of his ship",
  "Trenin's left work glove"
 ],
