 "meter": {
  "name": "La Sera di Toriano",
  "short": "Column inches",
  "icon": "📰",
  "about": "Toriano's evening paper measures you in column inches. Vale Meroni, its junior reporter, writes up every request you finish here, and big jobs make big stories. The Sindaco's approval rating stays back in Monteforchetta.",
  "reward": "+%d column inches",
  "display": {
   "format": "%d in."
  },
  "milestones": [
   {
    "at": 10,
    "id": "metropolis_notice",
    "title": "A notice on page 18",
    "desc": "\"New Geometra in town.\" Four lines under the crossword. The paper sends you the city's streetlight plans to go with it.",
    "blueprints": [
     "streetlight"
    ]
   },
   {
    "at": 25,
    "id": "metropolis_photo",
    "title": "Your photo in the paper",
    "desc": "A photo with a caption: you, a plank and a pigeon. And a winter outfit to go with it, so you look the part: a long camel coat and a red wool scarf.",
    "clothes": [
     "longcoat",
     "metropolis_camelcoat",
     "metropolis_redscarf"
    ]
   },
   {
    "at": 45,
    "id": "metropolis_interview",
    "title": "An interview, half a page",
    "desc": "\"The Geometra on Toriano: lovely city, terrible toilets.\" Ragioniere Sala reads it too, and the bathroom plans arrive the next morning.",
    "blueprints": [
     "toilet",
     "washbasin",
     "bathtub"
    ],
    "flags": [
     "metropolis_interview"
    ]
   },
   {
    "at": 70,
    "id": "metropolis_column",
    "title": "Your own weekly column",
    "desc": "\"The Geometra Answers\": readers' building questions, every Thursday. Your roof terrace at number 14 grows along the whole back wing.",
    "flags": [
     "metropolis_column"
    ]
   },
   {
    "at": 90,
    "id": "metropolis_radio",
    "title": "On the radio",
    "desc": "Radio Naviglio interviews you live. They send a portable radio for your flat, so you can hear yourself on the repeat.",
    "flags": [
     "metropolis_radio"
    ]
   },
   {
    "at": 120,
    "id": "metropolis_front_page",
    "title": "The front page, on Christmas Day",
    "desc": "The Golden Angel shines over the square, and your name is under the headline. Vale gets her promotion, and the framed front page hangs in your flat.",
    "requires": {
     "quests": [
      "metropolis_angel"
     ]
    },
    "waits": "the Golden Angel lit",
    "flags": [
     "metropolis_front_page"
    ]
   }
  ]
 },
