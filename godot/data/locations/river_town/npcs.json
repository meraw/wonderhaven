   "greetings": [
    {
     "flag": "river_town_bridge_open",
     "lines": [
      "Boats. Holding hands. Good.",
      "Forty years I rowed. Now people walk. I watch them. Also good."
     ]
    },
    {
     "lines": [
      "River took my boat.",
      "…",
      "Morning."
     ]
    }
   ],
   "sleepy": [
    "…"
   ],
   "topics": [
    {
     "id": "caronte",
     "label": "Why Caronte?",
     "lines": [
      "Ferryman of the dead. In the old stories.",
      "I take people across. They come back. Mostly.",
      "I like the name. Don't tell them."
     ]
    },
    {
     "id": "ferry",
     "label": "What happened to your ferry?",
     "lines": [
      "Flood. Rope snapped. She went under by the bank.",
      "Forty years. She was tired.",
      "A bridge of boats would do. Boats side by side, planks on top. Like before my grandfather."
     ]
    }
   ],
   "gifts": [
    {
     "hearts": 4,
     "items": {
      "wood": 6
     },
     "line": "Driftwood. Dry now. Use it."
    }
   ]
