   "greetings": [
    {
     "flag": "river_town_monster_seen",
     "lines": [
      "We caught him. We let him go. Now nobody believes us. Perfect. It's how it should be."
     ]
    },
    {
     "lines": [
      "Nineteen fifty-one. Right there, at the meeting of the rivers. A head like a bathtub.",
      "The monster's still down there, you know. Waiting. Getting bigger. Like my stories."
     ]
    }
   ],
   "sleepy": [
    "Zzz… a head like a bathtub… two bathtubs…"
   ],
   "topics": [
    {
     "id": "monster",
     "label": "Tell me about the monster.",
     "lines": [
      "The catfish. Big as a boat, whiskers like a mayor. Every flood, he comes up for a look.",
      "Three people saw him in the main street this time. Swimming past the bar. Rina says it was a log. Rina wasn't looking."
     ]
    },
    {
     "id": "mattia",
     "label": "And your nephew?",
     "lines": [
      "Mattia. Fifteen. Doesn't believe in anything he can't see on television.",
      "But he comes fishing with me every day. Says it's for the fresh air. It's for the monster. He just doesn't know it yet."
     ]
    }
   ],
   "gifts": [
    {
     "hearts": 4,
     "items": {
      "fish": 3
     },
     "line": "For your supper. Not the monster. Don't worry."
    }
   ]
