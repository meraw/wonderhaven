   "greetings": [
    {
     "flag": "river_town_hall_open",
     "lines": [
      "One, two, three, one, two, three. The parquet sings again, Geometra.",
      "Every Saturday. Every Saturday until I'm a hundred."
     ]
    },
    {
     "lines": [
      "My parquet. My beautiful parquet. Under a metre of river.",
      "Regional champion, nineteen sixty-eight. Waltz, polka and mazurka. I still have the shoes. I'm wearing them.",
      "Dance with me later. Not now. Now I'm grieving."
     ]
    }
   ],
   "sleepy": [
    "Zzz… one, two, three… one, two, three…"
   ],
   "topics": [
    {
     "id": "hall",
     "label": "Tell me about your dance hall.",
     "lines": [
      "Built on stilts in nineteen fifty-two, so the river could pass underneath. The river disagreed.",
      "Every Saturday the whole valley came. Farmers, bakers, the girls from the rice fields, boys on bicycles with their hair combed flat.",
      "Now it's mud and broken windows and a smell I won't describe."
     ]
    },
    {
     "id": "champion",
     "label": "Were you really a champion?",
     "lines": [
      "Regional. Nineteen sixty-eight. My partner had two left feet, so I danced for both of us.",
      "The trophy was on the bar in the hall. The flood took it. Somewhere out there is a little gold couple, dancing in the mud."
     ]
    }
   ],
   "gifts": [
    {
     "hearts": 4,
     "items": {
      "fabric": 3
     },
     "line": "Velvet from the old curtains. The good bits. Make something that sways."
    }
   ]
