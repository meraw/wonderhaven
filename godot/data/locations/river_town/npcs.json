   "greetings": [
    {
     "flag": "river_town_monster_seen",
     "lines": [
      "I've got the photo. It's real. Nobody believes it. Even I don't believe it, and I took it."
     ]
    },
    {
     "lines": [
      "Uncle Gildo says there's a monster. There isn't. I just come for the… air.",
      "My Walkman's full of river water. Now every song sounds like it's underwater. It's actually quite good."
     ]
    }
   ],
   "sleepy": [
    "Zzz… it's not real… it's not… real…"
   ],
   "topics": [
    {
     "id": "monster",
     "label": "Do you believe in the monster?",
     "lines": [
      "No. Obviously. Catfish don't get that big.",
      "…How big do catfish get, though? Asking for my uncle."
     ]
    }
   ],
   "gifts": [
    {
     "hearts": 3,
     "items": {
      "coins": 4
     },
     "line": "Found it in the mud. It's yours. Don't tell my uncle, he'll say the monster dropped it."
    }
