   "greetings": [
    {
     "flag": "river_town_flood_over",
     "lines": [
      "One hundred and twelve centimetres this morning. Normal. Boring. Wonderful.",
      "The river and I have made our peace. For now. I don't trust it."
     ]
    },
    {
     "flag": "river_town_welcomed",
     "lines": [
      "Three hundred and forty centimetres at eight o'clock. Going down. Slowly. Like my patience.",
      "Morning, Geometra. The river's still sulking. So am I. We understand each other.",
      "Don't stand on the levee in your nice shoes. Actually, you haven't got nice shoes. Carry on."
     ]
    },
    {
     "lines": [
      "You. The Geometra. Good. Here's a shovel."
     ]
    }
   ],
   "sleepy": [
    "Zzz… three hundred and… thirty-nine… point five…"
   ],
   "topics": [
    {
     "id": "gauge",
     "label": "Why do they call you Centimetro?",
     "lines": [
      "Because I know where the river is to the centimetre. Every hour, for forty years. It's in the notebook.",
      "My wife says I read the gauge in my sleep. I don't. I read it when I wake up at night, which is different."
     ]
    },
    {
     "id": "flood",
     "label": "What happened in the flood?",
     "lines": [
      "Seven metres forty at the gauge. The highest since my father's time.",
      "The water came over at the weak spot and went straight into the piazza. Rina served coffee standing on the counter.",
      "The levee held everywhere but there. Now it's our job to make sure the weak spot isn't weak."
     ]
    },
    {
     "id": "mayor",
     "label": "Who runs the town?",
     "lines": [
      "Nobody runs it. The river runs it, and I keep an eye on the river.",
      "There's a council somewhere. It sends letters. Pierina reads them to me so I don't have to."
     ]
    }
   ],
   "gifts": [
    {
     "hearts": 4,
     "items": {
      "river_town_sand": 6
     },
     "line": "Sand from the sandbank. Good sand. You'll want it when the river tries again."
    }
   ]
  },
