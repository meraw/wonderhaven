   "greetings": [
    {
     "lines": [
      "Ah, the Geometra! On foot? On foot. We'll fix that one day.",
      "1953. The Colle delle Rane. I passed a boy who later won the national championship. He'd had a puncture, but I passed him.",
      "If it has two wheels I can mend it. If it has four, I don't want to know about it."
     ]
    }
   ],
   "sleepy": [
    "Zzz… left at the chapel… then the long descent…"
   ],
   "topics": [
    {
     "id": "raggio",
     "label": "Why do they call you Raggio?",
     "lines": [
      "A raggio is a spoke. I can true a wheel by ear. Ping, ping, pong. That pong is wrong.",
      "Also I'm thin. Thin as a spoke. Was. Rina's cakes are my enemy."
     ]
    },
    {
     "id": "cars",
     "label": "What have you got against cars?",
     "lines": [
      "Nothing. They're fine for carrying wardrobes.",
      "But a town where people pedal is a town where people say good morning. You can't say good morning through a windscreen."
     ]
    }
   ],
   "gifts": [
    {
     "hearts": 4,
     "items": {
      "metal": 3
     },
     "line": "Spokes, bent. You'll find a use. I always do."
    }
   ]
