   "topics": [
    {
     "id": "round",
     "label": "How's the post round?",
     "lines": [
      "Slow and steady. Every door, every day, every coffee.",
      "Since the flood half the letters are from the insurance. I read the envelopes so people know what's coming."
     ]
    },
    {
     "id": "news",
     "label": "What's the news?",
     "lines": [
      "Ermes wrote to the river authority again. Four pages. They'll write back in March.",
      "Somebody's cuckoo clock was seen up a willow. It still cuckoos. On the hour. Very upsetting for the herons."
     ]
    }
   ],
